# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# The Vivid Builder API. Server-only on purpose: the browser talks to
# /api/vivid/* on this origin, which relays here. Giving it NEXT_PUBLIC_ would
# only tempt a direct call, and the backend's CORS allowlist rejects that.
VIVID_API_BASE=https://vivid.tsionark.io/v1

# Decane, from the Decane dashboard. Both server-only.
# DECANE_API_KEY is a secret (dck_live_…) and must never reach a browser.
DECANE_APP_ID=
DECANE_API_KEY=

# Optional: ES256 SPKI PEM. Set it to verify Decane tokens offline instead of
# fetching the JWKS.
# DECANE_VERIFICATION_KEY=

# Needed only for "Continue with Google". decane-node cannot run Google's
# redirect flow, so the browser gets the Google ID token and hands it to
# /api/auth/google. Email sign-in works without this.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
